# ───────── Backend (copy to .env for local dev, or set on your host) ─────────
ADMIN_PASSWORD=choose-a-strong-password
# Long random string, e.g. run:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_TOKEN_SECRET=
# Where registrations.xlsx is stored. On a host this MUST be a persistent disk.
DATA_DIR=./data
# Which sites may call the API (your GitHub Pages URL / custom domain), comma separated.
ALLOWED_ORIGINS=http://localhost:3000

# ───────── Frontend (only needed at build time) ─────────
# Leave empty for local dev. For GitHub Pages, set as a repo *variable* named VITE_API_URL.
VITE_API_URL=
